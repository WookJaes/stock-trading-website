DOMAIN=stocks.example.com

PASSWORD=
# 별도의 충분히 긴 임의 문자열을 권장합니다. 비어 있으면 PASSWORD로 세션을 서명합니다.
SESSION_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# false이면 전략 신호만 기록하고 주문은 실행하지 않습니다.
# 국내·해외 모의투자 자동매도를 검증한 뒤에만 true로 변경합니다.
ENABLE_MOCK_STRATEGY_ORDERS=false

KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

KIS_MOCK_DOMESTIC_APP_KEY=
KIS_MOCK_DOMESTIC_APP_SECRET=
KIS_MOCK_OVERSEAS_APP_KEY=
KIS_MOCK_OVERSEAS_APP_SECRET=

# 실투자 인증정보는 조회 기능에만 사용되며 매수·매도는 코드에서 차단됩니다.
# 모든 앱 키와 시크릿은 서버의 .env에만 저장하고 Git에 커밋하지 않습니다.
